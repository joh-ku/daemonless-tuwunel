# --------------------------------------------------------------------------
# THIS FILE IS AUTOGENERATED - DO NOT EDIT MANUALLY
#
# Source: Containerfile.j2
# --------------------------------------------------------------------------

ARG BASE_VERSION=15.1
ARG APP_VERSION=""
ARG UPSTREAM_URL="https://api.github.com/repos/matrix-construct/tuwunel/releases/latest"
ARG UPSTREAM_JQ=".tag_name"

# ---------------------------------------------------------------------------
# Builder: compile Tuwunel from upstream source
# ---------------------------------------------------------------------------
ARG BUILDER_BASE_VERSION=15.1-latest
FROM ghcr.io/daemonless/base-exec:${BUILDER_BASE_VERSION} AS builder

ARG APP_VERSION

RUN pkg update && \
    pkg install -y FreeBSD-set-devel rust llvm21 pkgconf cmake-core gmake zstd && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

COPY patches/ /patches/

# Fetch upstream source and apply local patches (same as the net-im/tuwunel port)
RUN if [ -z "${APP_VERSION}" ]; then \
    APP_VERSION=$(fetch -qo - "https://api.github.com/repos/matrix-construct/tuwunel/releases/latest" | \
    sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'); \
    fi && \
    test -n "${APP_VERSION}" && \
    echo "${APP_VERSION#v}" > /tmp/version && \
    mkdir -p /src && \
    fetch -qo - "https://github.com/matrix-construct/tuwunel/archive/refs/tags/${APP_VERSION}.tar.gz" | \
    tar -C /src -xzf - --strip-components 1 && \
    for p in /patches/patch-*; do patch -s -d /src -p0 -i "${p}" || exit 1; done

WORKDIR /src
ENV CARGO_INCREMENTAL=0 \
    CARGO_PROFILE_RELEASE_LTO=off \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16 \
    CARGO_PROFILE_RELEASE_DEBUG=false \
    CARGO_PROFILE_RELEASE_SPLIT_DEBUGINFO=off \
    CARGO_PROFILE_RELEASE_STRIP=symbols

# Exclude Linux-only default features (io_uring, systemd)
RUN cargo build --release --locked --no-default-features \
    --features "brotli_compression,element_hacks,gzip_compression,jemalloc,media_thumbnail,release_max_log_level,url_preview,zstd_compression" && \
    install -m 0755 /src/target/release/tuwunel /usr/local/bin/tuwunel && \
    /usr/local/bin/tuwunel --version && \
    rm -rf /src/target /root/.cargo

# ---------------------------------------------------------------------------
# Runtime: minimal base-exec with only ca_root_nss and zstd
# ---------------------------------------------------------------------------
FROM ghcr.io/daemonless/base-exec:${BASE_VERSION}

ARG FREEBSD_ARCH=amd64
ARG APP_VERSION
ARG UPSTREAM_URL
ARG UPSTREAM_JQ
ARG PACKAGES="ca_root_nss zstd"
ARG HEALTHCHECK_ENDPOINT="http://127.0.0.1:8008/_matrix/client/versions"

ENV HEALTHCHECK_URL="${HEALTHCHECK_ENDPOINT}"

LABEL org.opencontainers.image.title="Tuwunel" \
    org.opencontainers.image.description="High-performance Matrix homeserver written in Rust with embedded RocksDB storage, built from upstream source for FreeBSD." \
    org.opencontainers.image.source="https://github.com/daemonless/daemonless-tuwunel" \
    org.opencontainers.image.url="" \
    org.opencontainers.image.documentation="https://matrix-construct.github.io/tuwunel/" \
    org.opencontainers.image.licenses="Apache-2.0" \
    org.opencontainers.image.vendor="daemonless" \
    org.opencontainers.image.authors="daemonless" \
    io.daemonless.category="Infrastructure" \
io.daemonless.port="8008" \
io.daemonless.volumes="/config,/data" \
io.daemonless.arch="${FREEBSD_ARCH}" \
    io.daemonless.pkg-source="source" \
    io.daemonless.upstream-url="${UPSTREAM_URL}" \
    io.daemonless.upstream-jq="${UPSTREAM_JQ}" \
    io.daemonless.healthcheck-url="${HEALTHCHECK_ENDPOINT}" \
    io.daemonless.packages="${PACKAGES}"

RUN pkg update && \
    pkg install -y ${PACKAGES} && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

RUN mkdir -p /app /config /data && \
    chown -R bsd:bsd /app /config /data && \
    chmod 0755 /app && \
    chmod 0750 /config /data

COPY --chmod=0755 --from=builder /usr/local/bin/tuwunel /usr/local/bin/tuwunel
COPY --chmod=0644 --chown=bsd:bsd --from=builder /tmp/version /app/version

COPY root/ /
RUN chmod +x /daemonless/init.d/* /daemonless/libexec/tuwunel /healthz

CMD ["/daemonless/libexec/tuwunel"]
EXPOSE 8008
VOLUME /config /data